Dialogue: 0,0:00:15.80,0:00:17.30,Signs,,0,0,0,,ÇEVİRİ: YUSHİ
Dialogue: 0,0:00:20.43,0:00:23.56,Default,,0,0,0,,Okula yine... geç kaldım.
Dialogue: 0,0:01:56.19,0:01:57.79,Default,,0,0,0,,Kaydolduğundan beri,
Dialogue: 0,0:01:56.99,0:01:59.32,Signs,,0,0,0,,{\an8}ÖĞRETMENLER ODASI
Dialogue: 0,0:01:57.79,0:02:01.41,Default,,0,0,0,,Japonca deneme sınavlarında\Nsürekli tam puan aldın.
Dialogue: 0,0:02:02.03,0:02:04.45,Default,,0,0,0,,{\an1}Hatta sayısız\Nedebiyat ödülü kazandın.
Dialogue: 0,0:02:02.45,0:02:05.66,Signs,,0,0,0,,{\an8}1. SINIF 2. ŞUBE REHBER ÖĞRETMENİ\NSATOMI HIRATSUKA
Dialogue: 0,0:02:04.45,0:02:07.08,Default,,0,0,0,,Bu gerçekten inanılmaz, Mizunoe.
Dialogue: 0,0:02:05.83,0:02:08.12,Signs,,0,0,0,,{\an8}LİSE 1. SINIF\NUME MIZUNOE
Dialogue: 0,0:02:08.54,0:02:10.96,Default,,0,0,0,,Ah, hayır, böyle bir övgüyü hak etmiyorum.
Dialogue: 0,0:02:10.96,0:02:12.96,Default,,0,0,0,,Bu kadar mütevazı davranma.
Dialogue: 0,0:02:13.21,0:02:15.96,Default,,0,0,0,,Not ortalaman\N50'yi bile geçemedi!
Dialogue: 0,0:02:15.96,0:02:19.22,Default,,0,0,0,,Harfler yavaşça yükselip\Ngözlerimin önünde dans ediyor.
Dialogue: 0,0:02:20.59,0:02:23.18,Default,,0,0,0,,Bana diyorlar ki,\N"Yazarın kastettiği şey bu.
Dialogue: 0,0:02:24.26,0:02:27.02,Default,,0,0,0,,Sen de kendini edebiyata verirsen\Nböyle olabilirsin."
Dialogue: 0,0:02:27.02,0:02:28.69,Default,,0,0,0,,Cidden mi? Dikkatli olsam iyi olur.
Dialogue: 0,0:02:29.14,0:02:31.15,Default,,0,0,0,,Ama cidden, ne kadar etkileyici.
Dialogue: 0,0:02:31.48,0:02:34.98,Default,,0,0,0,,Kibar ve uslusun,\Nöğretmenler tarafından da seviliyorsun.
Dialogue: 0,0:02:35.44,0:02:36.69,Default,,0,0,0,,Belki de abarttım?
Dialogue: 0,0:02:36.69,0:02:37.53,Default,,0,0,0,,Hayır, ciddiyim.
Dialogue: 0,0:02:38.11,0:02:40.95,Default,,0,0,0,,Sınıfta kalacağını\Nasla tahmin etmezdim.
Dialogue: 0,0:02:42.24,0:02:45.04,Default,,0,0,0,,{\an8}Ha? Ne? Sınıfta mı kalıyorum?\NBen mi? Ama neden?
Dialogue: 0,0:02:45.04,0:02:47.20,Default,,0,0,0,,{\an8}Neden mi? Gerçekten bu kadar şaşırdın mı?
Dialogue: 0,0:02:47.75,0:02:50.75,Default,,0,0,0,,Fen derslerindeki bu felaket\Nnotlar da neyin nesi?!
Dialogue: 0,0:02:51.62,0:02:56.25,Default,,0,0,0,,Bak, bu sefer ben bile,\Nrehber öğretmenin olarak, yapamam...
Dialogue: 0,0:02:57.01,0:02:59.76,Default,,0,0,0,,Evet... Sanırım sen bile\Nbenim için bunun üstünü örtemezsin.
Dialogue: 0,0:03:00.09,0:03:01.89,Default,,0,0,0,,Primimi kesecekler!
Dialogue: 0,0:03:01.89,0:03:03.18,Default,,0,0,0,,Ne boktan bir öğretmen!
Dialogue: 0,0:03:03.43,0:03:14.86,Signs,,0,0,0,,{\an7}BUGÜNÜN DESENİ
Dialogue: 0,0:03:03.68,0:03:06.18,Default,,0,0,0,,Bu notlar tavsiye edilme\Nşansını zedeleyecek.
Dialogue: 0,0:03:06.85,0:03:08.81,Default,,0,0,0,,Ne demek, "Ne?\NTabii ki zedeleyecek!
Dialogue: 0,0:03:09.06,0:03:12.15,Default,,0,0,0,,Bu gerçekten iyi değil. Keşke\Nsenin için yapabileceğim bir şey olsaydı.
Dialogue: 0,0:03:12.15,0:03:14.86,Default,,0,0,0,,Ama akademik durumunu düzeltmek için\Nyapabileceğin şeyler sınırlı...
Dialogue: 0,0:03:15.02,0:03:18.32,Signs,,0,0,0,,{\an7}İYİ FİKİR!
Dialogue: 0,0:03:15.27,0:03:18.32,Default,,0,0,0,,Ah, evet: Öğrenci konseyine\Nkatılmaya ne dersin?
Dialogue: 0,0:03:18.99,0:03:21.20,Default,,0,0,0,,{\an8}Öğrenci konseyi mi?\NBu çok alakasız.
Dialogue: 0,0:03:21.20,0:03:31.92,Signs,,0,0,0,,{\an7}BUGÜNÜN DESENİ
Dialogue: 0,0:03:21.20,0:03:24.16,Default,,0,0,0,,Evet, kulağa hoş geliyor. Bu senin\Nakademik durumunu iyileştirir.
Dialogue: 0,0:03:24.16,0:03:26.41,Default,,0,0,0,,Öğrenci arkadaşlarını desteklemede\Nönemli bir figür olursun.
Dialogue: 0,0:03:26.41,0:03:28.24,Default,,0,0,0,,Peki ya kulüp etkinliklerim ne olacak?
Dialogue: 0,0:03:28.24,0:03:31.08,Default,,0,0,0,,Biriyle çıkamayan sen bile,\Nbaşarılı bir lise hayatı yaşayabilirsin!
Dialogue: 0,0:03:32.21,0:03:34.50,Default,,0,0,0,,- Pekala! Öğrenci konseyi!\N- {\i1}Kulağa şüpheli geliyor.{\i0}
Dialogue: 0,0:03:35.42,0:03:39.30,Default,,0,0,0,,Şey, yakın zamanda biri ayrıldı,\nyani aslında biraz zor durumdaydım.
Dialogue: 0,0:03:39.30,0:03:41.09,Default,,0,0,0,,Yani her şey seninle ilgiliymiş.
Dialogue: 0,0:03:41.09,0:03:42.43,Default,,0,0,0,,Hayır, seni aptal.
Dialogue: 0,0:03:43.01,0:03:46.01,Default,,0,0,0,,Gelecek yıl buralarda olmazsan\Nben de seni özlerim.
Dialogue: 0,0:03:49.85,0:03:51.43,Default,,0,0,0,,Sana kişisel olarak da\Ngüveniyorum, tamam mı?
Dialogue: 0,0:03:52.19,0:03:53.19,Default,,0,0,0,,{\i1}Öğretmenim...!{\i0}
Dialogue: 0,0:03:53.60,0:03:56.23,Default,,0,0,0,,Pekala! Karar verildi!\NPrim kesintisi önlendi! İyi iş!
Dialogue: 0,0:03:56.23,0:03:58.98,Default,,0,0,0,,Şimdi eve gitme, yemek yeme,\N31 patlatma ve uyuma vakti!
Dialogue: 0,0:03:58.98,0:04:00.19,Default,,0,0,0,,Rolüne devam edebilirdin.
Dialogue: 0,0:04:00.36,0:04:03.20,Signs,,0,0,0,,{\an3}ERKEK VELETLERİN DE DELİKLERİ VARDIR...
Dialogue: 0,0:04:03.78,0:04:05.53,Default,,0,0,0,,Demek öğrenci konseyi odası burası.
Dialogue: 0,0:04:06.07,0:04:10.04,Default,,0,0,0,,Şuna bak, kendini beğenmiş, sanki bir otorite sembolüymüş gibi. Dayanamıyorum buna.
Dialogue: 0,0:04:11.37,0:04:13.04,Default,,0,0,0,,Aman tanrım. Sen...
Dialogue: 0,0:04:13.62,0:04:16.77,Signs,,0,0,0,,{\an8}LİSE 2. SINIF\NARISU TERUI
Dialogue: 0,0:04:13.62,0:04:16.63,Default,,0,0,0,,Ume Mizunoe!\NBiz de seni bekliyorduk.
Dialogue: 0,0:04:14.08,0:04:16.77,Signs,,0,0,0,,{\an4}GÜLÜMSE\NGÜLÜMSE
Dialogue: 0,0:04:17.63,0:04:18.29,Default,,0,0,0,,Merhaba.
Dialogue: 0,0:04:18.59,0:04:19.80,Default,,0,0,0,,{\i1}Çok güzel!{\i0}
Dialogue: 0,0:04:20.13,0:04:23.43,Default,,0,0,0,,Öğrenci konseyindeki senpaim olmalısın.\NTanıştığımıza çok memnun oldum...
Dialogue: 0,0:04:24.88,0:04:26.05,Default,,0,0,0,,Senpai...
Dialogue: 0,0:04:26.72,0:04:29.97,Default,,0,0,0,,Ah, evet. Senin senpainim.\NBeni utandırıyorsun.
Dialogue: 0,0:04:29.97,0:04:33.60,Default,,0,0,0,,{\i1}Ne tatlı biri. Belki de\Nöğrenci konseyi o kadar da kötü değildir.{\i0}
Dialogue: 0,0:04:33.85,0:04:35.23,Default,,0,0,0,,{\an8}Hadi içeri geçelim.
Dialogue: 0,0:04:35.23,0:04:37.23,Default,,0,0,0,,{\an8}- Başardık! Gerçekten başardık!\N- Tamam.
Dialogue: 0,0:04:37.40,0:04:41.32,Default,,0,0,0,,Sonunda bitti! Tatsuko\NMk.32 kendinden tahrikli Form G!
Dialogue: 0,0:04:41.32,0:04:43.40,Default,,0,0,0,,Başardık! Artık robot yarışmasını\Nkesinlikle kazanacağız!
Dialogue: 0,0:04:43.40,0:04:44.90,Default,,0,0,0,,Koridorda koşmak yasak.
Dialogue: 0,0:04:48.83,0:04:50.24,Default,,0,0,0,,- Hayır! Mk.32!\N- Hadi içeri gel.
Dialogue: 0,0:04:50.24,0:04:51.24,Default,,0,0,0,,Devam et! Hâlâ yapabilirsin...
Dialogue: 0,0:04:51.41,0:04:51.87,Default,,0,0,0,,Devam et! Hâlâ yapabilirsin...
Dialogue: 0,0:04:52.20,0:04:54.98,Default,,0,0,0,,Kendimi tanıtayım.\NBen sayman Terui.
Dialogue: 0,0:04:54.98,0:04:56.50,Default,,0,0,0,,Tanıştığıma memnun oldum.
Dialogue: 0,0:04:56.92,0:04:57.50,Default,,0,0,0,,Ah, evet.
Dialogue: 0,0:04:58.08,0:04:59.59,Default,,0,0,0,,Ben de birinci sınıf Mizunoe.
Dialogue: 0,0:05:00.00,0:05:02.26,Default,,0,0,0,,{\an8\i1}Bir kohai'ye karşı bu kadar kibar davranıyor.
Dialogue: 0,0:05:02.55,0:05:04.22,Default,,0,0,0,,{\an8\i1}Belki de az önce hayal görüyordum.
Dialogue: 0,0:05:06.34,0:05:08.35,Default,,0,0,0,,Ah, az önce göz göze geldik.
Dialogue: 0,0:05:09.22,0:05:11.06,Default,,0,0,0,,- {\i1}O korkutucu biri!\N{\i0}- Merhaba!
Dialogue: 0,0:05:12.35,0:05:13.98,Default,,0,0,0,,Yeni kişi sen misin?!
Dialogue: 0,0:05:14.56,0:05:17.31,Default,,0,0,0,,{\an8}Duyduğumdan daha da\Nyakışıklıymışsın!
Dialogue: 0,0:05:15.81,0:05:17.40,Signs,,0,0,0,,{\an8}ORTAOKUL 3. SINIF\NTAN OTORI
Dialogue: 0,0:05:17.69,0:05:21.94,Default,,0,0,0,,Sen Mizunouchi-senpaisin, değil mi?\NO gözlükler çok ateşli!
Dialogue: 0,0:05:21.94,0:05:24.36,Default,,0,0,0,,Mizunoe! Sen kimsin?!\NBana öyle dokunma...
Dialogue: 0,0:05:26.24,0:05:27.91,Default,,0,0,0,,Gözlerin!
Dialogue: 0,0:05:28.20,0:05:30.83,Default,,0,0,0,,Meme uçlarıma bakıyorlar!
Dialogue: 0,0:05:31.45,0:05:32.67,Default,,0,0,0,,Ah, evet. Bir dakika, ne?!
Dialogue: 0,0:05:32.83,0:05:37.54,Default,,0,0,0,,Amanın. Erkekler çok basit! Çok kirli!
Dialogue: 0,0:05:37.54,0:05:40.92,Default,,0,0,0,,Hayır, bu değil... Bekle, sen kimsin?\NÖğrenci konseyinde misin?!
Dialogue: 0,0:05:40.92,0:05:43.05,Default,,0,0,0,,Konuyu değiştirme!
Dialogue: 0,0:05:43.05,0:05:47.18,Default,,0,0,0,,Beni dikizlemen hakkında\Nkonuşuyoruz, hatırladın mı Paisen?
Dialogue: 0,0:05:47.47,0:05:51.89,Default,,0,0,0,,{\an8}Pekala Paisen! Yakalandığına göre,\Nbedelini ödemelisin!
Dialogue: 0,0:05:51.89,0:05:54.56,Default,,0,0,0,,{\an8}İlk vukuatın olduğu için sana bir kıyak geçip\Nbuna 5.000 yen diyeceğim...
Dialogue: 0,0:06:00.52,0:06:01.82,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:06:01.82,0:06:05.49,Default,,0,0,0,,O öğrenci konseyinin bir parçası,\nama erkeklere asılma gibi bir huyu var.
Dialogue: 0,0:06:05.49,0:06:07.45,Default,,0,0,0,,- Bunu hep yapıyor.\N- {\i1}Neden katılmalarına izin verdiniz?{\i0}
Dialogue: 0,0:06:08.74,0:06:11.53,Default,,0,0,0,,Seni tanıştırayım.\NBu Tan, Halkla İlişkiler sorumlusu.
Dialogue: 0,0:06:11.99,0:06:14.04,Default,,0,0,0,,İster inan ister inanma, o erkek bir birey.
Dialogue: 0,0:06:14.04,0:06:17.21,Default,,0,0,0,,Bu insanlar öğrenci konseyinde mi?\NDünya yokuş aşağı gidiyor.
Dialogue: 0,0:06:17.47,0:06:18.58,Default,,0,0,0,,Bekle, o bir erkek mi?!
Dialogue: 0,0:06:19.29,0:06:22.21,Default,,0,0,0,,Meme uçları TV'de göründüğünde\Nbu oldukça belli değil miydi?
Dialogue: 0,0:06:22.75,0:06:23.67,Default,,0,0,0,,Evet, sanırım öyle.
Dialogue: 0,0:06:23.67,0:06:25.96,Default,,0,0,0,,Yine de, şu an kadın olabilir.
Dialogue: 0,0:06:27.59,0:06:29.38,Default,,0,0,0,,Yer darmadağın.
Dialogue: 0,0:06:29.84,0:06:32.68,Default,,0,0,0,,Lütfen şununla siler misin?\NMinnettar olurum.
Dialogue: 0,0:06:33.30,0:06:34.81,Default,,0,0,0,,Tabii ki.
Dialogue: 0,0:06:36.52,0:06:39.56,Default,,0,0,0,,Yani ilk işim bir\Nsapığın pisliğiyle uğraşmak.
Dialogue: 0,0:06:40.44,0:06:41.90,Default,,0,0,0,,Bu bezin şekli tuhaf.
Dialogue: 0,0:06:43.23,0:06:44.61,Signs,,0,0,0,,OYUNCAK AYI
Dialogue: 0,0:06:45.32,0:06:48.74,Default,,0,0,0,,Cee! Sürpriz! Sadece şaka yapıyorum!
Dialogue: 0,0:06:49.11,0:06:50.24,Default,,0,0,0,,Bu belden aşağı bir şaka mıydı?!
Dialogue: 0,0:06:51.03,0:06:53.16,Default,,0,0,0,,Ah, bu senin tarzın değil mi?
Dialogue: 0,0:06:53.16,0:06:55.41,Default,,0,0,0,,Hayır, ben... Bununla alakası yok!
Dialogue: 0,0:06:55.41,0:06:57.62,Default,,0,0,0,,Sadece... lütfen biraz standardınız olsun!
Dialogue: 0,0:06:57.62,0:06:58.96,Default,,0,0,0,,Özür dilerim, geç kaldım!
Dialogue: 0,0:06:59.50,0:07:02.13,Default,,0,0,0,,Üst mercilerle olan toplantı\Nuzun sürdü!
Dialogue: 0,0:07:00.00,0:07:03.29,Signs,,0,0,0,,{\an5}LİSE 3. SINIF\NHISAKO KOTOBUKI
Dialogue: 0,0:07:02.46,0:07:04.42,Default,,0,0,0,,Yeni kişi burada... değil mi?
Dialogue: 0,0:07:05.59,0:07:07.88,Default,,0,0,0,,- Onlar benim külotlarım!\N- Ne? O da kim?
Dialogue: 0,0:07:08.59,0:07:10.26,Default,,0,0,0,,Ne halt ediyorsun sen?!
Dialogue: 0,0:07:10.26,0:07:11.51,Default,,0,0,0,,Hayır! Ben sadece...
Dialogue: 0,0:07:11.51,0:07:14.05,Default,,0,0,0,,Bu dün bulduğum kayıp bir eşya.
Dialogue: 0,0:07:14.05,0:07:14.85,Default,,0,0,0,,- Ne?!\N- Kayıp eşya mı?
Dialogue: 0,0:07:15.51,0:07:17.31,Default,,0,0,0,,Biraz hızlı yargıya vardım.
Dialogue: 0,0:07:17.89,0:07:20.02,Default,,0,0,0,,- Senpai...\N- Düşündüğün gibi değil!
Dialogue: 0,0:07:20.02,0:07:21.48,Default,,0,0,0,,{\i1}Okuması aşırı kolay biri.{\i0}
Dialogue: 0,0:07:22.60,0:07:23.81,Default,,0,0,0,,Bu kan da ne?
Dialogue: 0,0:07:24.27,0:07:27.40,Default,,0,0,0,,Özür dilerim,\Nfark etmemiş olsam bile... Nam.
Dialogue: 0,0:07:27.40,0:07:28.57,Default,,0,0,0,,Ah, bu arada Ume.
Dialogue: 0,0:07:29.49,0:07:32.74,Default,,0,0,0,,Külodunu yıkayan şu iri göğüslü olan\Nöğrenci konseyi başkanı.
Dialogue: 0,0:07:32.49,0:07:34.32,Signs,,0,0,0,,{\an8}ÖĞRENCİ KONSEYİ BAŞKANI\NHISAKO
Dialogue: 0,0:07:32.74,0:07:34.32,Default,,0,0,0,,O mu öğrenci konseyi başkanı?
Dialogue: 0,0:07:34.82,0:07:38.66,Default,,0,0,0,,Öyle görünmeyebilir ama çok zeki,\Natletik ve saygıdeğerdir.
Dialogue: 0,0:07:39.12,0:07:41.96,Default,,0,0,0,,Sadece külodunu yıkıyor diye\Nonu yargılama!
Dialogue: 0,0:07:42.46,0:07:43.21,Default,,0,0,0,,{\i1}O kız mı?
Dialogue: 0,0:07:44.42,0:07:46.71,Default,,0,0,0,,Bunun için kusura bakma Mizunoe.\NSonunda kendimi tanıtayım.
Dialogue: 0,0:07:46.71,0:07:49.71,Default,,0,0,0,,Ben Kotobuki,\Nöğrenci konseyi başkanı.
Dialogue: 0,0:07:49.71,0:07:51.84,Default,,0,0,0,,Hemen görevlerinin\Nüzerinden geçelim.
Dialogue: 0,0:07:52.26,0:07:52.76,Default,,0,0,0,,Tamam.
Dialogue: 0,0:07:53.22,0:07:56.01,Default,,0,0,0,,İşte öğrenci konseyi ve ilgili\Nkuruluşların organizasyon şeması.
Dialogue: 0,0:07:56.26,0:07:59.60,Default,,0,0,0,,Ayrıca her rolün görevlerini detaylandıran\Nbelgeler de hazırladım.
Dialogue: 0,0:08:00.10,0:08:03.73,Default,,0,0,0,,Biliyorum çok fazla ama lütfen hafta sonuna\Nkadar her şeyi oku.
Dialogue: 0,0:08:04.65,0:08:08.02,Default,,0,0,0,,Etkileyici. Her şey bir bakışta\Nanlaşılacak şekilde düzenlenmiş.
Dialogue: 0,0:08:08.02,0:08:11.44,Default,,0,0,0,,Bu da benim şahsen\Nyürüttüğüm bir proje.
Dialogue: 0,0:08:11.70,0:08:14.16,Default,,0,0,0,,Temel olarak yerel halkla\Netkileşime odaklanıyor.
Dialogue: 0,0:08:14.49,0:08:17.99,Default,,0,0,0,,Bunun için acele etmene gerek yok,\no yüzden zamanın olduğunda göz at lütfen.
Dialogue: 0,0:08:18.49,0:08:20.25,Default,,0,0,0,,{\an8}Sen gerçekten öğrenci konseyi başkanısın.
Dialogue: 0,0:08:21.12,0:08:22.37,Default,,0,0,0,,{\an8}Ha? Şey, evet.
Dialogue: 0,0:08:22.37,0:08:24.46,Default,,0,0,0,,{\an8}Neredeyse "külotlu kişi"\Nolarak tanınacaktın.
Dialogue: 0,0:08:26.13,0:08:30.55,Default,,0,0,0,,O zaman işe koyulalım!\NSekreterlik rolünü üstlenmeni istiyorum.
Dialogue: 0,0:08:30.55,0:08:31.34,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:31.34,0:08:33.76,Default,,0,0,0,,Japonca senin en iyi derslerinden\Nbiri. Sana güveniyorum!
Dialogue: 0,0:08:34.09,0:08:37.39,Default,,0,0,0,,Şey... Deneme sınavlarında genelde\Nbirinci oluyorum.
Dialogue: 0,0:08:37.39,0:08:40.56,Default,,0,0,0,,{\an8}Vay canına, bu harika!\NNasıl bu kadar yüksek puanlar alıyorsun?
Dialogue: 0,0:08:40.56,0:08:41.22,Default,,0,0,0,,Ah.
Dialogue: 0,0:08:41.77,0:08:44.73,Default,,0,0,0,,Japonca diline hakimiyet\Nbir gecede kazanılamaz.
Dialogue: 0,0:08:44.73,0:08:48.94,Default,,0,0,0,,Günlük hayatınızda dile nasıl baktığınızla ve zihninizin durumuyla beslenir.
Dialogue: 0,0:08:48.94,0:08:50.48,Default,,0,0,0,,Bu yüzden kelimeleri sadece\Nbirer araç olarak görmemeye,
Dialogue: 0,0:08:50.48,0:08:55.16,Default,,0,0,0,,daha ziyade içlerinde gizli olan\Ngüzelliği takdir etmeye çalışıyorum.
Dialogue: 0,0:08:55.16,0:08:57.95,Default,,0,0,0,,Kısacası, dili basitçe\Nsevdiğimi söyleyebilirsin.
Dialogue: 0,0:08:58.50,0:08:59.70,Default,,0,0,0,,Ah... Bu çok cringe.
Dialogue: 0,0:09:00.04,0:09:00.99,Default,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:09:00.99,0:09:02.91,Default,,0,0,0,,Pekala Mizunoe!
Dialogue: 0,0:09:02.91,0:09:06.21,Default,,0,0,0,,Bugünlük, herkesi çalışırken\Ngözlemlemenle başlayalım.
Dialogue: 0,0:09:06.88,0:09:09.00,Default,,0,0,0,,Ne? Gözlemlemek mi?\NAma ben sekreter değil miyim?
Dialogue: 0,0:09:09.00,0:09:12.21,Default,,0,0,0,,Sorun şu ki, sekreterin\Nyapacağı pek bir şey yok,
Dialogue: 0,0:09:12.21,0:09:14.47,Default,,0,0,0,,bu yüzden diğerlerinin işlerine de\Nyardımcı olmanı istiyorum.
Dialogue: 0,0:09:15.26,0:09:17.93,Default,,0,0,0,,Yardımcı olmak mı? Yani, temel olarak...
Dialogue: 0,0:09:18.76,0:09:20.76,Default,,0,0,0,,arkalarını temizlemek, ha?
Dialogue: 0,0:09:21.93,0:09:24.31,Default,,0,0,0,,O halde benimle başlayalım!\NHalkla ilişkilerden ben sorumluyum!
Dialogue: 0,0:09:22.81,0:09:24.89,Signs,,0,0,0,,{\an8}HALKLA İLİŞKİLER\NTAN OTORI
Dialogue: 0,0:09:24.31,0:09:24.89,Default,,0,0,0,,Çok iğrenç.
Dialogue: 0,0:09:25.56,0:09:26.73,Default,,0,0,0,,Hım, evet, tabii. Teşekkürler...
Dialogue: 0,0:09:26.73,0:09:29.61,Default,,0,0,0,,Ah, ama biliyorsun çok meşgulüm.
Dialogue: 0,0:09:29.61,0:09:31.19,Default,,0,0,0,,Ne yapmalıyım?
Dialogue: 0,0:09:32.15,0:09:33.94,Default,,0,0,0,,Yo, fikrimi değiştirdim!
Dialogue: 0,0:09:34.28,0:09:35.65,Default,,0,0,0,,Ah, her neyse. Unut gitsin.
Dialogue: 0,0:09:36.61,0:09:37.66,Default,,0,0,0,,Bacaklarını üstümden çek!
Dialogue: 0,0:09:38.28,0:09:39.53,Default,,0,0,0,,Halkla ilişkiler, ha?
Dialogue: 0,0:09:39.78,0:09:42.04,Default,,0,0,0,,Yani öğrenci konseyinin etkinliklerinin\Nreklamını mı yapıyorsun?
Dialogue: 0,0:09:42.04,0:09:43.95,Default,,0,0,0,,Kendi kendini tebrik ediyor gibi hissettiriyor.\NHiç hevesli değilim.
Dialogue: 0,0:09:43.95,0:09:46.21,Default,,0,0,0,,Ah, çok safsın paisen.
Dialogue: 0,0:09:46.21,0:09:47.12,Default,,0,0,0,,Bacaklarını kapat.
Dialogue: 0,0:09:47.12,0:09:49.25,Default,,0,0,0,,Her neyse, şuna bir bak!
Dialogue: 0,0:09:49.25,0:09:52.30,Default,,0,0,0,,Bu grafik okul festivalimize\Nkaç kişinin geldiğini gösteriyor!
Dialogue: 0,0:09:52.30,0:09:54.01,Default,,0,0,0,,Vay canına, geçen seneki o sıçrama çılgıncaymış!
Dialogue: 0,0:09:54.01,0:09:57.84,Default,,0,0,0,,İşte halkla ilişkiler becerilerimin yapabildiği şey bu!
Dialogue: 0,0:09:57.84,0:10:01.89,Default,,0,0,0,,İtiraf etmeliyim ki, bu gerçekten etkileyici.\NOkula çok fazla enerji getiriyorsun.
Dialogue: 0,0:10:02.18,0:10:04.31,Default,,0,0,0,,Peki ama böyle sonuçlar elde etmek için\Nne yaptın?
Dialogue: 0,0:10:04.47,0:10:08.52,Signs,,0,0,0,,{\an8}İLK SEFERİNİZ NE ZAMANDI?\NORTAOKUL / LİSE
Dialogue: 0,0:10:04.89,0:10:07.14,Default,,0,0,0,,Bunu resmi hesaptan yayınladığımda\Nviral oldu.
Dialogue: 0,0:10:07.14,0:10:08.69,Default,,0,0,0,,Hey! Bu çocuğu görevden alın!
Dialogue: 0,0:10:08.69,0:10:11.69,Default,,0,0,0,,Resmi hesapta ilk seferiniz hakkında\Npaylaşım yapmak mı? Ciddi misin?
Dialogue: 0,0:10:12.77,0:10:15.07,Default,,0,0,0,,Anket ilk kez saçınızı\Nne zaman boyattığınızı soruyordu.
Dialogue: 0,0:10:15.44,0:10:18.32,Default,,0,0,0,,- Ne?!\N- Ah? Sen ne olduğunu sanmıştın?
Dialogue: 0,0:10:18.32,0:10:21.16,Default,,0,0,0,,Benim masum küçük paisenim\Nne hayal etti acaba,
Dialogue: 0,0:10:21.16,0:10:22.99,Default,,0,0,0,,"ilk sefer" dediğimde?
Dialogue: 0,0:10:23.33,0:10:25.22,Default,,0,0,0,,Vay! Yüzün kıpkırmızı oldu!
Dialogue: 0,0:10:25.22,0:10:26.96,Default,,0,0,0,,Hey, dur! Dur, seni aptal!
Dialogue: 0,0:10:26.96,0:10:31.46,Default,,0,0,0,,Saklama! Hadi, bana şu\Nutangaç tarafını daha çok göster!
Dialogue: 0,0:10:33.34,0:10:34.75,Default,,0,0,0,,iMemeUcum!
Dialogue: 0,0:10:39.59,0:10:41.72,Default,,0,0,0,,{\an8}Sırada sayman var!
Dialogue: 0,0:10:40.14,0:10:41.72,Signs,,0,0,0,,{\an2}SAYMAN\NARISU TERUI
Dialogue: 0,0:10:42.14,0:10:44.76,Default,,0,0,0,,Saymanın işi tamamen rakamlardan\Nibaretmiş gibi görünebilir,
Dialogue: 0,0:10:45.14,0:10:47.02,Default,,0,0,0,,ama yazılımı öğrendikten sonra\Nhiç de zor değil.
Dialogue: 0,0:10:47.02,0:10:47.77,Default,,0,0,0,,{\i1}Çok yakın!
Dialogue: 0,0:10:47.77,0:10:50.38,Default,,0,0,0,,İşte geçen yılın bütçe kayıtları.
Dialogue: 0,0:10:50.38,0:10:52.31,Default,,0,0,0,,Taslak bir bütçe hazırlamak için\Nbunları bir başlangıç noktası olarak kullanabilirsin.
Dialogue: 0,0:10:52.31,0:10:53.90,Default,,0,0,0,,- Ve sonra...\N- {\i1}Neden yaklaşıyor?
Dialogue: 0,0:10:54.57,0:10:57.78,Default,,0,0,0,,Ardından, gelecek döneme ait bütçelerini bildirmek için\Nher kulübü ziyaret edeceğiz.
Dialogue: 0,0:10:57.78,0:10:58.40,Default,,0,0,0,,Tamam.
Dialogue: 0,0:10:58.82,0:11:01.78,Default,,0,0,0,,Her kulübe her zaman istedikleri\Nbütçeyi veremiyoruz,
Dialogue: 0,0:11:02.12,0:11:04.91,Default,,0,0,0,,bu yüzden bazen şikayetlerle\Nuğraşmak zorunda kalıyoruz.
Dialogue: 0,0:11:04.91,0:11:09.58,Default,,0,0,0,,Biraz zor olabilir,\Nama bu işin bir parçası.
Dialogue: 0,0:11:09.58,0:11:11.54,Default,,0,0,0,,Senpai'nin bir kalbi var.
Dialogue: 0,0:11:11.88,0:11:12.58,Signs,,0,0,0,,{\an2}MÜZİK KULÜBÜ
Dialogue: 0,0:11:12.96,0:11:14.00,Default,,0,0,0,,Bütçeniz... 500 Yen.
Dialogue: 0,0:11:14.92,0:11:17.09,Default,,0,0,0,,Ne?! Cidden mi?!\NBu bir menü parası falan!
Dialogue: 0,0:11:17.09,0:11:18.63,Default,,0,0,0,,Ama geçen sene o kadar şey yaptık ki!
Dialogue: 0,0:11:18.92,0:11:20.01,Default,,0,0,0,,{\an8}Üzgünüm,
Dialogue: 0,0:11:20.30,0:11:23.72,Default,,0,0,0,,{\an8}ama o 19 başarının 17'sinin\Nhiçbir maddi değeri yoktu.
Dialogue: 0,0:11:23.72,0:11:25.39,Default,,0,0,0,,{\an8}Bu da ne,\Nsahaf değerlemesi falan mı?!
Dialogue: 0,0:11:25.72,0:11:28.93,Default,,0,0,0,,Koki gitar yarışmasını bile kazandı.
Dialogue: 0,0:11:28.93,0:11:31.14,Default,,0,0,0,,Bize ayrıca bir rapor da geldi...
Dialogue: 0,0:11:31.56,0:11:32.60,Default,,0,0,0,,Ha?! Ne hakkında?
Dialogue: 0,0:11:32.60,0:11:34.11,Default,,0,0,0,,Bazı yakın\Ntemaslar olduğuna dair...
Dialogue: 0,0:11:34.11,0:11:36.11,Default,,0,0,0,,{\an8}Lanet olsun, bu kötü. Kaçalım!
Dialogue: 0,0:11:36.11,0:11:37.44,Default,,0,0,0,,{\an8\i1}Ne halt ediyorlar bunlar?{\i0}
Dialogue: 0,0:11:37.61,0:11:38.07,Signs,,0,0,0,,{\an2}YÜZME KULÜBÜ
Dialogue: 0,0:11:38.23,0:11:39.53,Default,,0,0,0,,{\an8}40.000 yen'lik bir kesinti var.
Dialogue: 0,0:11:39.53,0:11:41.53,Default,,0,0,0,,{\an8}Pekala! Hadi gidip harika\Naçık havada yüzelim!
Dialogue: 0,0:11:41.53,0:11:42.95,Default,,0,0,0,,{\an8}Evet kaptan!
Dialogue: 0,0:11:42.95,0:11:45.08,Default,,0,0,0,,{\an8}Bekleyin! Gelecek dönem\Nçok çalışmaya ne dersiniz?!
Dialogue: 0,0:11:45.24,0:11:45.62,Signs,,0,0,0,,{\an2}BİYOLOJİ KULÜBÜ
Dialogue: 0,0:11:45.95,0:11:47.58,Default,,0,0,0,,{\an8}%20 düşüş var.
Dialogue: 0,0:11:47.87,0:11:50.37,Default,,0,0,0,,{\an8}Artık size yemek alacak\Ndurumumuz yok.
Dialogue: 0,0:11:50.37,0:11:53.25,Default,,0,0,0,,{\an8}Gözlerimin önünde eriyip gitmenizi izlemektense,\Nşöyle yapmayı tercih ederim...
Dialogue: 0,0:11:53.25,0:11:55.79,Default,,0,0,0,,{\an8}Belki kafeteryaya arta kalan yemeklerini\Nalıp alamayacağınızı sorabilirsiniz?
Dialogue: 0,0:11:55.96,0:11:56.13,Signs,,0,0,0,,{\an2}VÜCUT GELİŞTİRME KULÜBÜ
Dialogue: 0,0:11:56.42,0:11:57.34,Default,,0,0,0,,Yarı yarıya kesiliyor.
Dialogue: 0,0:11:57.34,0:11:59.92,Default,,0,0,0,,Artık size protein tozu\Nveremeyeceğimizi söylediler...
Dialogue: 0,0:11:59.92,0:12:03.01,Default,,0,0,0,,Ben değilim!\NKaslarımın kendi iradesi var!
Dialogue: 0,0:12:03.01,0:12:06.47,Default,,0,0,0,,Senin gibi tatlı bir kohai ile dolaşmak\Ngerçekten çok daha eğlenceli.
Dialogue: 0,0:12:06.76,0:12:08.47,Default,,0,0,0,,Öyle düşünmene... sevindim.
Dialogue: 0,0:12:08.89,0:12:12.35,Default,,0,0,0,,Şey, her şey aşağı yukarı bu kadar.\NÜstesinden gelebileceğini düşünüyor musun?
Dialogue: 0,0:12:12.89,0:12:13.48,Default,,0,0,0,,Evet.
Dialogue: 0,0:12:14.15,0:12:16.15,Default,,0,0,0,,Görevler sorun değil.
Dialogue: 0,0:12:16.15,0:12:19.32,Default,,0,0,0,,İşin üstesinden gelebilirim,\nama buradaki insanlar...
Dialogue: 0,0:12:16.31,0:12:19.07,Signs,,0,0,0,,{\an7}KORKUTUCU KİŞİ\NKÜLOTLU KİŞİ / EZİK
Dialogue: 0,0:12:19.69,0:12:22.95,Default,,0,0,0,,Şey, neden gergin olduğunu anlıyorum.\Nİşler epey telaşlı olabiliyor.
Dialogue: 0,0:12:22.95,0:12:24.66,Default,,0,0,0,,- Ah, hayır. Bu doğru değil...\N- Ama biliyorsun...
Dialogue: 0,0:12:24.66,0:12:28.45,Default,,0,0,0,,Bize katılmanı\Ndört gözle bekliyorlardı.
Dialogue: 0,0:12:28.79,0:12:31.00,Default,,0,0,0,,Terui beklentiyle\Nözellikle huzursuzdu.
Dialogue: 0,0:12:31.41,0:12:34.90,Default,,0,0,0,,Şu an hepimiz burada değiliz,\nama hepsi iyi insanlar.
Dialogue: 0,0:12:34.90,0:12:38.04,Default,,0,0,0,,O yüzden... onlara güven.
Dialogue: 0,0:12:38.63,0:12:41.67,Default,,0,0,0,,Hepimiz aynı gemideyiz,\Ntüm öğrenci kitlesini temsil ediyoruz.
Dialogue: 0,0:12:42.84,0:12:45.59,Default,,0,0,0,,O halde, birlikte iyi bir yıla,
Dialogue: 0,0:12:45.97,0:12:47.01,Default,,0,0,0,,Mizunoe!
Dialogue: 0,0:12:47.72,0:12:48.85,Default,,0,0,0,,Tamam.
Dialogue: 0,0:12:49.60,0:12:53.31,Default,,0,0,0,,Kalbim neden böyle ağır atıyor,\Nsanki bir ergenlik dönemi okul hikayesinin başlangıcı gibi?
Dialogue: 0,0:12:53.85,0:12:57.44,Default,,0,0,0,,Sanki bir şeylerin\Nbaşlangıcını müjdeliyormuş gibi...
Dialogue: 0,0:12:58.77,0:13:02.36,Default,,0,0,0,,{\an8}Hey! Meme ucum sansürlenecek mi?!
Dialogue: 0,0:13:02.36,0:13:04.86,Default,,0,0,0,,Pipime neler oluyor?
Dialogue: 0,0:13:05.16,0:13:06.99,Default,,0,0,0,,Böylesine önemli bir anda böldüğüm\Niçin özür dilerim.
Dialogue: 0,0:13:06.99,0:13:09.95,Default,,0,0,0,,Halledildi. Lütfen devam edin.
Dialogue: 0,0:13:10.95,0:13:12.95,Default,,0,0,0,,Ah, evet, teşekkürler...
Dialogue: 0,0:13:12.95,0:13:14.33,Default,,0,0,0,,Hayır. Sözümü geri alıyorum. Tamam.
Dialogue: 0,0:13:15.42,0:13:16.37,Default,,0,0,0,,{\an8}Senin burada olman harika!
Dialogue: 0,0:13:19.50,0:13:21.50,Default,,0,0,0,,Şuradaki kalın harfli kısmı\Ndoldurabilir misin?
Dialogue: 0,0:13:22.26,0:13:22.80,Default,,0,0,0,,Ah, evet.
Dialogue: 0,0:13:24.47,0:13:25.51,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:13:25.51,0:13:26.93,Default,,0,0,0,,Sadece, bunu birlikte yapmak
Dialogue: 0,0:13:27.47,0:13:30.06,Default,,0,0,0,,{\an8}artık aynı takımın bir parçasıymışız gibi\Nhissettiriyor.
Dialogue: 0,0:13:31.22,0:13:34.85,Default,,0,0,0,,{\i1}Olukların çatlak tahtaları arasından\Naçan yalnız bir menekşe.{\i0}
Dialogue: 0,0:13:37.23,0:13:40.44,Default,,0,0,0,,Pekala, bu bitti.\NSıradaki için kırmızıyı kullanacağım.
Dialogue: 0,0:13:43.94,0:13:46.20,Default,,0,0,0,,Afedersin, dikkatsizlik ettim!
Dialogue: 0,0:13:47.49,0:13:50.58,Signs,,0,0,0,,{\an8}GÜLÜMSEYEN
Dialogue: 0,0:13:48.87,0:13:50.58,Default,,0,0,0,,Bir çift gibi el\Nele tutuşmuş olduk.
Dialogue: 0,0:13:51.03,0:13:52.91,Default,,0,0,0,,{\an8}Çok telaşlandım!
Dialogue: 0,0:13:53.62,0:13:54.70,Default,,0,0,0,,{\an8}Evet. Ben de.
Dialogue: 0,0:13:55.21,0:13:58.58,Default,,0,0,0,,Buyur sen onu kullan.\NBen kendiminkini kullanırım.
Dialogue: 0,0:13:59.25,0:13:59.75,Default,,0,0,0,,Ah, tamam.
Dialogue: 0,0:14:00.59,0:14:01.59,Default,,0,0,0,,{\i1}Çok olgun biri.{\i0}
Dialogue: 0,0:14:02.30,0:14:04.92,Default,,0,0,0,,{\i1}Bir erkeğin eli kocamanmış!
Dialogue: 0,0:14:02.38,0:14:05.51,Signs,,0,0,0,,{\an8}GÜM GÜM GÜM GÜM
Dialogue: 0,0:14:04.92,0:14:05.97,Default,,0,0,0,,{\i1}O aslında tam bir çocuk.{\i0}
Dialogue: 0,0:14:06.30,0:14:08.09,Default,,0,0,0,,{\i1}İlk defa birine dokundum!
Dialogue: 0,0:14:08.09,0:14:11.01,Default,,0,0,0,,{\i1}Kalın, boğumlu ve kocamandı!
Dialogue: 0,0:14:11.93,0:14:13.64,Default,,0,0,0,,{\i1}Üstelik bir de gizli sapık.
Dialogue: 0,0:14:14.14,0:14:17.27,Signs,,0,0,0,,{\an8}BEDEN EĞİTİMİ ÇALIŞIYOR
Dialogue: 0,0:14:14.14,0:14:17.27,Default,,0,0,0,,Kalın, boğumlu ve kocaman...
Dialogue: 0,0:14:17.44,0:14:20.27,Signs,,0,0,0,,{\an8}BAŞKAN UME TARAFINDAN GELİNİ OLARAK\NALINDI
Dialogue: 0,0:14:20.65,0:14:22.73,Default,,0,0,0,,Bugün etrafta dolaşıp öğrencileri\Nselamlayacağız!
Dialogue: 0,0:14:23.07,0:14:24.61,Default,,0,0,0,,{\an8}- Anlaşıldı.\N- Geç kaldım.
Dialogue: 0,0:14:23.40,0:14:24.86,Signs,,0,0,0,,{\an2}GEÇ KALDIM
Dialogue: 0,0:14:24.61,0:14:27.74,Default,,0,0,0,,{\an8}Sadece gelip geçen insanları\Nselamlamam gerekiyor, değil mi?
Dialogue: 0,0:14:27.74,0:14:30.95,Default,,0,0,0,,Evet! Bu kuşağın hakkını verecek\Nkadar enerjiyle!
Dialogue: 0,0:14:31.32,0:14:32.37,Default,,0,0,0,,Ve bir şey daha...
Dialogue: 0,0:14:32.37,0:14:36.67,Default,,0,0,0,,Evet! Bu sefer okul kurallarının ihlal edilip\Nedilmediğini de kontrol edeceğiz!
Dialogue: 0,0:14:36.67,0:14:39.12,Default,,0,0,0,,Çok heyecan verici değil mi Ume?
Dialogue: 0,0:14:39.12,0:14:41.54,Default,,0,0,0,,Ne? Hayır, ben, şey...
Dialogue: 0,0:14:42.00,0:14:44.63,Default,,0,0,0,,Okul disiplinini elbette\Nkorumak istiyorum
Dialogue: 0,0:14:44.88,0:14:47.97,Default,,0,0,0,,ama korkarım insanları ihlallerinden dolayı\Ndoğrudan uyarma konusunda pek rahat değilim.
Dialogue: 0,0:14:48.43,0:14:52.14,Default,,0,0,0,,Sanırım kendimi biraz fazla\Nkaptırdım.
Dialogue: 0,0:14:52.72,0:14:55.85,Default,,0,0,0,,{\an8}Şey, bugün asıl işimiz\Ninsanları selamlamak zaten,
Dialogue: 0,0:14:55.85,0:14:58.27,Default,,0,0,0,,{\an8}o yüzden belki bunu hafif bir çanta\Ndenetimiyle sınırlı tutarız.
Dialogue: 0,0:14:58.69,0:14:59.73,Default,,0,0,0,,{\an8\i1}Terui-senpai!{\i0}
Dialogue: 0,0:15:00.40,0:15:01.77,Default,,0,0,0,,Ah, bir şeker.\NBu bir kural ihlali!
Dialogue: 0,0:15:01.77,0:15:03.90,Default,,0,0,0,,- Abur cuburum!\N- Katlanıver.
Dialogue: 0,0:15:03.90,0:15:05.11,Default,,0,0,0,,{\i1}Bunu yapmayı gerçekten hiç istemiyorum...
Dialogue: 0,0:15:07.99,0:15:10.57,Default,,0,0,0,,{\an8}Günaydın. Üzgünüm ama çantanı\Ndenetlemem gerekiyor.
Dialogue: 0,0:15:10.57,0:15:12.53,Default,,0,0,0,,{\an8}Ne?! Seni duyamıyorum!
Dialogue: 0,0:15:12.91,0:15:14.70,Default,,0,0,0,,Bu hiç iyi gitmiyor.
Dialogue: 0,0:15:14.99,0:15:16.79,Default,,0,0,0,,Zorlanıyor musun, Mizunoe?
Dialogue: 0,0:15:17.37,0:15:20.71,Default,,0,0,0,,Sesini diyaframından\Nçıkar
Dialogue: 0,0:15:20.71,0:15:23.92,Default,,0,0,0,,Buralardan bir yerden, tamam mı?\Nİşte böyle, biraz daha güç ver.
Dialogue: 0,0:15:24.25,0:15:25.42,Default,,0,0,0,,{\i1}Sanırım denemeye devam edeceğim.{\i0}
Dialogue: 0,0:15:26.05,0:15:27.55,Default,,0,0,0,,{\i1}Pekala, elimden gelenin en iyisini yapacağım.{\i0}
Dialogue: 0,0:15:28.84,0:15:30.96,Default,,0,0,0,,{\i1}Uygunsuz üniforma,\Nkulaklık, onaysız çanta...
Dialogue: 0,0:15:30.96,0:15:33.05,Default,,0,0,0,,{\i1}Resmen ayaklı bir okul kuralı ihlali!{\i0}
Dialogue: 0,0:15:33.60,0:15:36.81,Default,,0,0,0,,{\i1}Demek tokmağımı indireceğim ilk kişi bu.{\i0}
Dialogue: 0,0:15:36.81,0:15:37.72,Default,,0,0,0,,Sen.
Dialogue: 0,0:15:39.35,0:15:40.89,Default,,0,0,0,,Pislik Tan!
Dialogue: 0,0:15:41.23,0:15:44.36,Signs,,0,0,0,,{\an2}CEZA HÜCRESİ
Dialogue: 0,0:15:41.52,0:15:43.48,Default,,0,0,0,,{\an8}Ben tavşan değilim.
Dialogue: 0,0:15:43.48,0:15:45.11,Default,,0,0,0,,{\an8}- Tatlı olduğum için beni tavşan mı sandın?\N- O da ne?!
Dialogue: 0,0:15:45.11,0:15:48.53,Default,,0,0,0,,Yürürken sigara içmek mi?! Bu kutsal\Nöğrenim yuvasında buna nasıl cüret ederler?!
Dialogue: 0,0:15:48.53,0:15:50.07,Default,,0,0,0,,Onları derhal uyarmalıyım...
Dialogue: 0,0:15:50.74,0:15:51.70,Default,,0,0,0,,Hey. Naber Mizunoe?
Dialogue: 0,0:15:51.99,0:15:53.78,Signs,,0,0,0,,{\an2}CEZA HÜCRESİ
Dialogue: 0,0:15:54.24,0:15:56.74,Default,,0,0,0,,{\i1}Bir avuç baş belası olmakla ünlü\Nmüzik kulübü!{\i0}
Dialogue: 0,0:15:56.99,0:15:58.50,Default,,0,0,0,,{\i1}Okul kuralı ihlallerinin geldiğini\Nhissedebiliyorum.{\i0}
Dialogue: 0,0:15:59.08,0:16:02.67,Default,,0,0,0,,Günaydın. Özür dilerim,\Nçanta denetimi yapıyoruz.
Dialogue: 0,0:16:04.38,0:16:05.34,Default,,0,0,0,,Ah, affedersiniz...
Dialogue: 0,0:16:06.17,0:16:07.84,Default,,0,0,0,,Hey, beklenmedik derecede işbirlikçi.
Dialogue: 0,0:16:09.17,0:16:12.59,Default,,0,0,0,,Ah, buradaki bir ihlal,\No yüzden buna el koyuyorum.
Dialogue: 0,0:16:14.05,0:16:16.60,Default,,0,0,0,,Cidden, eğer sadece ağlayacaksan,\Nöyle havalı davranma.
Dialogue: 0,0:16:16.60,0:16:18.81,Default,,0,0,0,,Ne yapacağız?\NBunun için hepimiz para toplamıştık.
Dialogue: 0,0:16:18.81,0:16:19.97,Default,,0,0,0,,Tüm bunlar da neydi böyle?
Dialogue: 0,0:16:19.97,0:16:22.73,Default,,0,0,0,,Müzik kulübü 10.000 yen\Ncezaya çarptırıldı.
Dialogue: 0,0:16:24.19,0:16:26.82,Default,,0,0,0,,Epey miktarda\Nihlal tespit ettik.
Dialogue: 0,0:16:26.82,0:16:30.15,Default,,0,0,0,,El koyduğum şu şeyle\Nne yapmalıyız?
Dialogue: 0,0:16:30.49,0:16:35.03,Default,,0,0,0,,Normalde onu çöpe atardık ama bunun için pek bir emsal yok.
Dialogue: 0,0:16:35.03,0:16:36.91,Default,,0,0,0,,Evet, atılmalı.
Dialogue: 0,0:16:37.20,0:16:39.91,Default,,0,0,0,,Ama ağlıyordu ve hiçbir kitap\Nbir diğerinden daha iyi veya daha kötü değildir.
Dialogue: 0,0:16:40.95,0:16:43.00,Default,,0,0,0,,- Birlikte okumak ister misin?\N- Ne?!
Dialogue: 0,0:16:43.67,0:16:44.54,Default,,0,0,0,,Ama neden?!
Dialogue: 0,0:16:44.54,0:16:48.84,Default,,0,0,0,,Kurallara göre mangalar çöpe atılır,\Nromanlar ise iade edilir.
Dialogue: 0,0:16:49.42,0:16:53.38,Default,,0,0,0,,Erotik bir kitap olsa bile,\Nbence onu incelemeliyiz.
Dialogue: 0,0:16:53.38,0:16:55.97,Default,,0,0,0,,{\i1}Senpai! Hislerimi\Ndikkate aldı.{\i0}
Dialogue: 0,0:16:56.89,0:16:58.30,Default,,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:16:58.30,0:17:01.89,Default,,0,0,0,,Hayır, hayır. O hislerin\Nçok önemli.
Dialogue: 0,0:17:01.89,0:17:03.10,Default,,0,0,0,,O halde daha fazla uzatmadan...
Dialogue: 0,0:17:03.73,0:17:06.60,Default,,0,0,0,,{\i1}Ne de olsa Ume de bir erkek.{\i0}
Dialogue: 0,0:17:07.11,0:17:09.61,Default,,0,0,0,,Pekala o zaman, acele etmeyelim ve\Nilk sayfadan itibaren üzerinden geçelim!
Dialogue: 0,0:17:10.11,0:17:10.73,Default,,0,0,0,,Tamam!
Dialogue: 0,0:17:11.19,0:17:13.36,Default,,0,0,0,,Vay canına, erotik resimlerle dolu.
Dialogue: 0,0:17:13.82,0:17:15.12,Default,,0,0,0,,İtiraf etmeliyim ki, bu...
Dialogue: 0,0:17:15.12,0:17:18.03,Default,,0,0,0,,Ama alt yazılarda yine de\Nbiraz edebi bir nitelik var.
Dialogue: 0,0:17:18.78,0:17:23.12,Default,,0,0,0,,O sırılsıklam olmuş mahrem yere karşı\Nzonklayan erkeklik...
Dialogue: 0,0:17:23.12,0:17:25.25,Default,,0,0,0,,Hey! Yüksek sesle\Nokumana gerek yok!
Dialogue: 0,0:17:25.25,0:17:25.83,Default,,0,0,0,,Aman tanrım.
Dialogue: 0,0:17:26.08,0:17:36.68,Signs,,0,0,0,,{\an8}TAMAMEN BASTIRILMIŞ
Dialogue: 0,0:17:26.08,0:17:29.21,Default,,0,0,0,,Bu cesurmuş.\NBunun hakkında ne düşünüyorsun Ume?
Dialogue: 0,0:17:29.71,0:17:32.30,Default,,0,0,0,,- Ha? Ne demek istiyorsun?\N- Hoşuna gitti mi gitmedi mi?
Dialogue: 0,0:17:32.30,0:17:34.76,Default,,0,0,0,,Vay, çok açık.
Dialogue: 0,0:17:34.76,0:17:36.68,Default,,0,0,0,,Hoşuma gidip gitmemesi\Nönemli değil!
Dialogue: 0,0:17:37.84,0:17:39.47,Default,,0,0,0,,{\an8}Yani, Başkan.
Dialogue: 0,0:17:39.47,0:17:40.43,Default,,0,0,0,,Başkan?
Dialogue: 0,0:17:41.81,0:17:42.77,Default,,0,0,0,,Ha? Ne var?
Dialogue: 0,0:17:43.10,0:17:45.02,Default,,0,0,0,,Peki sen bu konuda ne düşünüyorsun,\NBaşkan?
Dialogue: 0,0:17:46.02,0:17:48.27,Default,,0,0,0,,Ah, şey...
Dialogue: 0,0:17:50.11,0:17:53.65,Default,,0,0,0,,Yani... Bence gerçekten çok seksi...
Dialogue: 0,0:17:55.49,0:17:57.53,Default,,0,0,0,,Bunu tartışmayı\Nçoktan bitirdik.
Dialogue: 0,0:17:57.86,0:18:00.28,Default,,0,0,0,,El konulan kendamaya\Ngeçtik.
Dialogue: 0,0:18:01.20,0:18:02.87,Default,,0,0,0,,{\an8}Ne?! Ah, doğru!
Dialogue: 0,0:18:01.24,0:18:03.04,Signs,,0,0,0,,{\an2}KENDAMALAR SEKSİDİR
Dialogue: 0,0:18:03.66,0:18:06.00,Default,,0,0,0,,{\i1}Hiratsuka-sensei. Hiratsuka-sensei.{\i0}
Dialogue: 0,0:18:06.33,0:18:10.00,Default,,0,0,0,,{\i1}Öğretmenler toplantısı başladı.\NLütfen derhal öğretmenler odasına gelin.{\i0}
Dialogue: 0,0:18:10.63,0:18:12.84,Default,,0,0,0,,{\an8}Zonklayan... erkeklik...
Dialogue: 0,0:18:13.42,0:18:15.01,Default,,0,0,0,,{\an8}Hisako, hâlâ orada mısın?
Dialogue: 0,0:18:15.38,0:18:18.93,Default,,0,0,0,,Pekala, bugün tüm okulun katılacağı\Nbir toplanmamız var.
Dialogue: 0,0:18:19.39,0:18:22.35,Default,,0,0,0,,Bugün öğrenci konseyi\Nkonuşacak,
Dialogue: 0,0:18:22.35,0:18:23.81,Default,,0,0,0,,bu yüzden hepiniz hazır mısınız?
Dialogue: 0,0:18:24.35,0:18:27.85,Default,,0,0,0,,Evet. Yani, sen iyi misin Öğretmenim?
Dialogue: 0,0:18:27.85,0:18:30.94,Default,,0,0,0,,Kimsenin görmeyi beklemediği\Nbir panda gibi görünüyorsun.
Dialogue: 0,0:18:32.02,0:18:34.61,Default,,0,0,0,,Ha? Öğretmenlerin bugün konuşmasına\Ngerek yok, o yüzden ben iyiyim.
Dialogue: 0,0:18:35.15,0:18:36.32,Default,,0,0,0,,Tamam, bu iyi.
Dialogue: 0,0:18:37.03,0:18:38.36,Default,,0,0,0,,Tamam, başlamak üzere.
Dialogue: 0,0:18:39.61,0:18:41.95,Default,,0,0,0,,Kusura bakmayın, lavaboya koşacağım.
Dialogue: 0,0:18:41.95,0:18:43.08,Default,,0,0,0,,Hiç hazırlanmamışsın!
Dialogue: 0,0:18:44.45,0:18:46.12,Default,,0,0,0,,Öğretmen hâlâ gelmedi.
Dialogue: 0,0:18:46.62,0:18:49.67,Default,,0,0,0,,Beş dakikadan az kaldı.\NBir şey mi oldu?
Dialogue: 0,0:18:50.04,0:18:51.00,Default,,0,0,0,,Belki de kaka...
Dialogue: 0,0:18:51.71,0:18:53.09,Default,,0,0,0,,Evet, muhtemelen sigara içiyor.
Dialogue: 0,0:18:53.42,0:18:56.51,Default,,0,0,0,,{\an8}Düşününce,\Ngeçen hafta yangın alarmını çalıştırmıştı,
Dialogue: 0,0:18:56.51,0:18:58.38,Default,,0,0,0,,{\an8}tuvalette sigara içerken.
Dialogue: 0,0:18:58.72,0:19:01.39,Default,,0,0,0,,{\an8}Arzularına yenik düşmek konusunda\Ngerçekten çok aciz.
Dialogue: 0,0:19:01.39,0:19:03.85,Default,,0,0,0,,- Sonra sınıfına gitti.\N- Lütfen ayağa kalkın.
Dialogue: 0,0:19:03.85,0:19:06.56,Default,,0,0,0,,Bir şey zahmetli olduğunda\Nhep kolay yolu seçiyor.
Dialogue: 0,0:19:06.93,0:19:09.10,Default,,0,0,0,,Sonunda yetişemedim.
Dialogue: 0,0:19:09.52,0:19:12.44,Default,,0,0,0,,Bugün burada toplandığınız için\Nhepinize teşekkür ederim.
Dialogue: 0,0:19:12.81,0:19:14.65,Default,,0,0,0,,Bütün bunları ezberledi mi?
Dialogue: 0,0:19:15.03,0:19:17.74,Default,,0,0,0,,Tamamen doğaçlama. Buna alışkın,
Dialogue: 0,0:19:17.74,0:19:21.24,Default,,0,0,0,,ve çabuk düşünür.\Nİşte dönemin en iyi öğrencisi.
Dialogue: 0,0:19:21.61,0:19:22.95,Default,,0,0,0,,Etkileyici.
Dialogue: 0,0:19:23.32,0:19:25.70,Default,,0,0,0,,- Gizli bir sapık olmasına rağmen.\N- Gizli bir sapık olmasına rağmen.
Dialogue: 0,0:19:24.45,0:19:25.70,Default,,0,0,0,,{\an8}Benim tarafımdan bu kadar...
Dialogue: 0,0:19:26.12,0:19:28.41,Default,,0,0,0,,Sırada Halkla İlişkiler'den\Nbir duyurumuz var.
Dialogue: 0,0:19:29.12,0:19:30.29,Default,,0,0,0,,Sıra Otori'de.
Dialogue: 0,0:19:30.71,0:19:32.75,Default,,0,0,0,,İyi olacak mısın?
Dialogue: 0,0:19:33.08,0:19:35.96,Default,,0,0,0,,Öğretmenler de burada,\no yüzden toparlanmalısın.
Dialogue: 0,0:19:36.13,0:19:36.92,Signs,,0,0,0,,{\an8}HAYAL KIRIKLIĞINA UĞRAMIŞ
Dialogue: 0,0:19:37.38,0:19:39.59,Default,,0,0,0,,Şimdi, Halkla İlişkiler temsilcisi olarak,\Nokulumuzun toplum hizmeti faaliyetleri ile
Dialogue: 0,0:19:39.59,0:19:44.14,Default,,0,0,0,,bölgesel canlanma oranı arasındaki\Nilişkiyi tartışmak istiyorum...
Dialogue: 0,0:19:44.51,0:19:45.97,Default,,0,0,0,,Çok düzgün!\NKıyafetlerini bile değiştirmiş!
Dialogue: 0,0:19:45.97,0:19:47.89,Default,,0,0,0,,Ah, vay canına, bu nadir görülür.
Dialogue: 0,0:19:48.48,0:19:50.19,Default,,0,0,0,,Halkla İlişkiler'den bu kadar.
Dialogue: 0,0:19:50.89,0:19:53.48,Default,,0,0,0,,Sana ne oldu böyle?\NKötü bir şey mi yedin?
Dialogue: 0,0:19:53.77,0:19:58.19,Default,,0,0,0,,Ah, çocuk oyuncağıydı. Yeter ki\Nelimi taşın altına koyayım, anlarsın ya?
Dialogue: 0,0:19:58.49,0:20:00.74,Default,,0,0,0,,Her neyse, sen nasılsın Ume?\Nİyi olacak mısın?
Dialogue: 0,0:20:00.74,0:20:03.91,Default,,0,0,0,,Öğretmenler de burada,\no yüzden toparlanmalısın.
Dialogue: 0,0:20:04.32,0:20:05.87,Default,,0,0,0,,Sırada, sekreteri\Ndinleyeceğiz...
Dialogue: 0,0:20:06.53,0:20:07.62,Default,,0,0,0,,{\i1}Şu pislik!
Dialogue: 0,0:20:07.99,0:20:10.46,Default,,0,0,0,,{\i1}Kahretsin, aslında gerçekten\Nçok gerilmeye başladım.{\i0}
Dialogue: 0,0:20:10.79,0:20:12.83,Default,,0,0,0,,{\i1}Başkan ve Otori kusursuzdu...{\i0}
Dialogue: 0,0:20:13.29,0:20:14.83,Default,,0,0,0,,{\i1}Toparlanmam lazım!{\i0}
Dialogue: 0,0:20:14.83,0:20:16.54,Default,,0,0,0,,Ah, bu daha iyi hissettiriyor.
Dialogue: 0,0:20:17.21,0:20:20.72,Default,,0,0,0,,Ne haber Mizunoe?\NSolgun görünüyorsun. Kakan mı geldi?
Dialogue: 0,0:20:20.72,0:20:21.88,Default,,0,0,0,,Hayır, gerginim.
Dialogue: 0,0:20:22.13,0:20:26.18,Default,,0,0,0,,Hadi ama, buraya gelmek için\Nçok çalıştın.
Dialogue: 0,0:20:26.51,0:20:28.56,Default,,0,0,0,,Tek yapman gereken oraya çıkıp\Nelinden gelenin en iyisini yapmak.
Dialogue: 0,0:20:28.56,0:20:30.81,Default,,0,0,0,,İzliyor olacağım,\no yüzden başını dik tut.
Dialogue: 0,0:20:31.14,0:20:32.14,Default,,0,0,0,,Öğretmenim...
Dialogue: 0,0:20:32.14,0:20:34.15,Default,,0,0,0,,{\i1}Ama bana bundan\Ndaha dün bahsettin.{\i0}
Dialogue: 0,0:20:34.15,0:20:35.65,Default,,0,0,0,,{\i1}Yarın sana güveniyorum.
Dialogue: 0,0:20:36.86,0:20:38.48,Default,,0,0,0,,{\i1}Çabalarımın hiçbirini görmedin.{\i0}
Dialogue: 0,0:20:39.23,0:20:42.45,Default,,0,0,0,,Şimdi karşınızda konuşmasıyla
Dialogue: 0,0:20:42.45,0:20:44.57,Default,,0,0,0,,yeni atanan sekreterimiz\NUme Mizunoe.
Dialogue: 0,0:20:46.03,0:20:47.41,Default,,0,0,0,,Vay! Ne kadar çoklar!
Dialogue: 0,0:20:47.74,0:20:48.74,Default,,0,0,0,,Merhaba. Ben sekreter...
Dialogue: 0,0:20:49.29,0:20:50.58,Default,,0,0,0,,{\i1}O kadar gerginim ki,\Nsesim çatlıyor...{\i0}
Dialogue: 0,0:20:51.71,0:20:52.46,Default,,0,0,0,,Ah! Öğretmenim...
Dialogue: 0,0:20:52.75,0:20:54.83,Default,,0,0,0,,Sadece izle, Hiratsuka!
Dialogue: 0,0:20:55.42,0:20:58.13,Default,,0,0,0,,Şey, gerginliği atmaya yardımcı oldu\Nve işler şaşırtıcı derecede iyi gitti.
Dialogue: 0,0:20:59.17,0:21:01.88,Default,,0,0,0,,- Hiratsuka-sensei'ye nasıl hitap ettiği...\N- Ama öğrencilerin hepsi gaza geldi.
Dialogue: 0,0:21:02.80,0:21:07.14,Default,,0,0,0,,Tam senin sırandan önceki\Nkarışıklık için özür dilerim Senpai.
Dialogue: 0,0:21:07.60,0:21:08.97,Default,,0,0,0,,Ah, hiç sorun değil.
Dialogue: 0,0:21:09.81,0:21:11.27,Default,,0,0,0,,Ben Sayman Terui.
Dialogue: 0,0:21:10.31,0:21:14.73,Signs,,0,0,0,,{\an7}SESSİZLİK...
Dialogue: 0,0:21:13.44,0:21:14.27,Default,,0,0,0,,Bu bir cenaze töreni mi?
Dialogue: 0,0:21:15.90,0:21:17.73,Default,,0,0,0,,Öğrenci konseyinden bu kadar.
Dialogue: 0,0:21:18.11,0:21:20.44,Default,,0,0,0,,- Dinlediğiniz için hepinize teşekkürler.\N- Bunu atlatmayı başardık.
Dialogue: 0,0:21:20.73,0:21:21.94,Default,,0,0,0,,Evet, kesinlikle.
Dialogue: 0,0:21:21.94,0:21:23.45,Default,,0,0,0,,Çok sıkıcı!
Dialogue: 0,0:21:26.74,0:21:28.49,Signs,,0,0,0,,{\an7}GÜM
Dialogue: 0,0:21:26.87,0:21:28.49,Default,,0,0,0,,Tan, bunu unutmuşsun.
Dialogue: 0,0:21:34.46,0:21:35.87,Default,,0,0,0,,Tavşan çiftleşmesi...
Dialogue: 0,0:21:36.50,0:21:38.62,Default,,0,0,0,,Hey, bu geçen gün kulübede\Nçektiğim video.
Dialogue: 0,0:21:38.62,0:21:39.46,Default,,0,0,0,,Çok komik değil mi?
Dialogue: 0,0:21:39.46,0:21:40.84,Default,,0,0,0,,- Müdür Bey! Bu da ne?!\N- Ume!
Dialogue: 0,0:21:40.84,0:21:41.80,Default,,0,0,0,,- Çiftleşiyorlar!\N- Ha? Ah!
Dialogue: 0,0:21:42.67,0:21:43.67,Default,,0,0,0,,Başkan!
Dialogue: 0,0:21:44.51,0:21:46.97,Default,,0,0,0,,- Lütfen kapat şunu!\N- Acıttı!
Dialogue: 0,0:21:46.97,0:21:48.39,Default,,0,0,0,,- Mamografi mi?!\N- Özür dilerim.
Dialogue: 0,0:21:48.39,0:21:50.22,Default,,0,0,0,,Neden birden\Nmamografi gösteriyor?!
Dialogue: 0,0:21:50.22,0:21:52.52,Default,,0,0,0,,{\i1}Bu okul çapındaki toplanma\Nefsane oldu.{\i0}
Dialogue: 0,0:21:53.10,0:21:55.14,Default,,0,0,0,,Artık asla evlenemem.
Dialogue: 0,0:21:55.14,0:21:57.89,Default,,0,0,0,,Sanırım onu alması gereken kişi\Nartık Ume.
Dialogue: 0,0:21:57.89,0:21:59.02,Default,,0,0,0,,Ne?
Dialogue: 0,0:21:59.02,0:22:01.82,Default,,0,0,0,,{\i1}Mizunoe'nin Kotobuki'yi gelin olarak\Nalmasına karar verildi.{\i0}
